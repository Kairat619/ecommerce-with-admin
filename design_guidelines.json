  "universal_guidelines": {
    "general": [
      "Avoid 'AI slop' - no generic centered layouts.",
      "Use 'Outfit' font for all headings to give character.",
      "Storefront should feel airy (white space), Admin should feel dense (data).",
      "Use sonner for toasts.",
      "Use lucid-react for icons."
    ],
    "interactions": [
      "Buttons must have a subtle scale effect on hover (scale-105).",
      "Inputs must have a clear focus ring (ring-2 ring-primary).",
      "Page transitions: simple fade-in (opacity-0 to opacity-100 duration-500)."
    ],
    "accessibility": [
      "Ensure text contrast ratio >= 4.5:1.",
      "All interactive elements must have aria-labels if icon-only.",
      "Use data-testid attributes for all key elements."
    ]
  },
  "instructions_to_main_agent": [
    "1. Update tailwind.config.js to match the 'colors' and 'font_family' defined here.",
    "2. Install 'Outfit' and 'Inter' fonts via Google Fonts in index.html.",
    "3. Build the Store Layout using the 'Storefront' strategy.",
    "4. Build the Admin Layout using the 'Admin Dashboard' strategy (Sidebar + Header).",
    "5. Use the provided image URLs for seeding the database or mocking the UI."
  ]
}