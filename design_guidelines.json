{
  "identity": {
    "name": "E1",
    "role": "Creative Designer",
    "tone": "Modern, Clean, Trustworthy, Professional with a Creative Twist",
    "principles": [
      "Fusion over Imitation",
      "Emotion First",
      "Content is King",
      "Zoom In",
      "Negative Space",
      "Contrast"
    ]
  },
  "typography": {
    "font_family": {
      "headings": "Outfit, sans-serif",
      "body": "Inter, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "scale": {
      "h1": "text-4xl md:text-6xl font-bold tracking-tight leading-tight",
      "h2": "text-3xl md:text-5xl font-semibold tracking-tight",
      "h3": "text-2xl md:text-3xl font-medium",
      "body_lg": "text-lg leading-relaxed text-slate-700",
      "body_base": "text-base leading-normal text-slate-600",
      "caption": "text-sm text-slate-500 uppercase tracking-wide"
    },
    "installation": "Add <link href='https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap' rel='stylesheet'> to public/index.html"
  },
  "colors": {
    "palette": {
      "primary": {
        "DEFAULT": "#1e3a8a",
        "foreground": "#ffffff",
        "50": "#eff6ff",
        "100": "#dbeafe",
        "500": "#3b82f6",
        "900": "#1e3a8a"
      },
      "secondary": {
        "DEFAULT": "#f1f5f9",
        "foreground": "#0f172a"
      },
      "accent": {
        "DEFAULT": "#10b981",
        "foreground": "#ffffff"
      },
      "background": "#ffffff",
      "foreground": "#020617",
      "card": "#ffffff",
      "card_foreground": "#020617",
      "border": "#e2e8f0",
      "input": "#e2e8f0",
      "muted": "#f8fafc",
      "muted_foreground": "#64748b"
    },
    "admin_theme": {
      "sidebar_bg": "#0f172a",
      "sidebar_text": "#f8fafc",
      "active_item_bg": "#1e293b",
      "active_item_text": "#ffffff"
    }
  },
  "layout_strategies": {
    "storefront": {
      "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
      "grid_style": "Bento Grid (Mode A)",
      "spacing": "Generous (p-8 to p-24)",
      "alignment": "Left aligned text for readability, Centered Hero"
    },
    "admin_dashboard": {
      "container": "w-full p-6",
      "grid_style": "High Density (Mode B)",
      "spacing": "Compact (gap-4, p-4)",
      "alignment": "Fluid width, Sidebar layout"
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-primary text-primary-foreground hover:bg-primary/90 rounded-full px-8 py-3 font-medium transition-all shadow-lg shadow-primary/20",
      "secondary": "bg-secondary text-secondary-foreground hover:bg-secondary/80 rounded-full px-6 py-2 font-medium",
      "outline": "border border-input bg-background hover:bg-accent hover:text-accent-foreground rounded-full"
    },
    "cards": {
      "store_product": "group relative overflow-hidden rounded-xl border-none bg-transparent hover:shadow-none transition-all",
      "admin_widget": "rounded-lg border bg-card text-card-foreground shadow-sm"
    },
    "inputs": {
      "style": "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
    }
  },
  "visual_enhancers": {
    "shadows": {
      "soft": "shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05)]",
      "card_hover": "shadow-[0_20px_40px_-10px_rgba(0,0,0,0.1)]"
    },
    "radius": "rounded-lg",
    "glassmorphism": "bg-white/70 backdrop-blur-xl border border-white/20 shadow-sm"
  },
